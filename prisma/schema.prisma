generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PaymentMethod {
  CASH
  YAPE_PLIN
  CARD
}

model Product {
  id        String   @id @default(cuid())
  name      String
  price     Float
  costPrice Float    @default(0)
  stock     Int      @default(0)
  size      String
  unit      String
  active    Boolean  @default(true)
  code      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  saleItems       SaleItem[]
  promotionItems  PromotionItem[]

  @@map("products")
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("categories")
}

model Sale {
  id                  String     @id @default(cuid())
  saleCode            String     @unique
  total               Float
  paymentMethod       PaymentMethod @default(CASH)
  date                DateTime   @default(now())
  createdAt           DateTime   @default(now())
  cancelled           Boolean    @default(false)
  cancellationReason  String?
  cancelledAt         DateTime?

  userId String?

  items       SaleItem[]
  combos      SaleCombo[]

  @@map("sales")
}

model SaleItem {
  id        String @id @default(cuid())
  productId String
  saleId    String
  quantity  Int
  unitPrice Float
  subtotal  Float
  product   Product @relation(fields: [productId], references: [id])
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@map("sale_items")
}

model Promotion {
  id        String   @id @default(cuid())
  name      String
  price     Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  items      PromotionItem[]
  saleCombos SaleCombo[]

  @@map("promotions")
}

model PromotionItem {
  id          String @id @default(cuid())
  promotionId String
  productId   String
  quantity    Int

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@map("promotion_items")
}

model SaleCombo {
  id          String @id @default(cuid())
  saleId      String
  promotionId String
  quantity    Int
  subtotal    Float

  sale      Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  promotion Promotion @relation(fields: [promotionId], references: [id])

  @@map("sale_combos")
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  userId String?

  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@map("expenses")
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  expenses  Expense[]

  @@map("expense_categories")
}